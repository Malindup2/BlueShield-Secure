# ============================================
# BlueShield Backend - Environment Variables
# ============================================
# Copy this file to .env and replace every placeholder.
# Never commit the resulting .env file.

# Server
PORT=5000
NODE_ENV=development
ALLOWED_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173
TRUST_PROXY=
ENABLE_SWAGGER=true

# MongoDB
MONGO_URI=mongodb+srv://username:password@example.mongodb.net/blueshield

# Authentication
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRE=15m

# Login protection
MAX_LOGIN_ATTEMPTS=5
LOCK_TIME_MINUTES=15

# Rate limiting
RATE_LIMIT_IN_TESTS=0
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_GLOBAL_MAX=100
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=5

# Email
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USER=your_email@example.com
EMAIL_PASS=your_email_app_password

# Google Gemini AI
GEMINI_API_KEY=your_gemini_api_key

# Mapbox
MAPBOX_API_KEY=your_mapbox_api_key

# DataDocked VesselFinder API
DATADOCKED_API_KEY=your_datadocked_api_key

# MyShipTracking API
MYSHIPTRACKING_API_KEY=your_myshiptracking_api_key
MYSHIPTRACKING_BASE_URL=https://api.myshiptracking.com

# Beeceptor mock vessel API
BEECEPTOR_VESSEL_API_URL=https://example.free.beeceptor.com/api/vessels

# Position API
POSITION_API_BASE_URL=http://localhost:5050
POSITION_API_TIMEOUT_MS=15000

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Azure Translator
AZURE_TRANSLATOR_KEY=your_azure_translator_key
AZURE_TRANSLATOR_LOCATION=your_azure_region
AZURE_TRANSLATOR_ENDPOINT=https://api.cognitive.microsofttranslator.com